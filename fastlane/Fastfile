default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )
  end

  desc "Sync certificates and profiles"
  lane :certificates do
    match(type: "appstore", readonly: is_ci)
  end

  # Prerequisite: the Push Notifications capability must already be enabled on
  # the App ID in the Apple Developer portal. (produce can't do it in CI — it
  # falls back to interactive Apple-ID 2FA auth, which the API key can't satisfy.)
  desc "Force-regenerate the App Store profile so it picks up the App ID's capabilities"
  lane :regen_profiles do
    match(type: "appstore", force: true, readonly: false)
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    if ENV["CI"] && ENV["GITHUB_RUN_NUMBER"]
      build_number = (10_000 + ENV["GITHUB_RUN_NUMBER"].to_i).to_s
      ENV["SQUAD_BUILD_NUMBER"] = build_number
      increment_build_number(
        build_number: build_number,
        xcodeproj: "meetup-ios.xcodeproj"
      )
    end

    match(type: "appstore", readonly: is_ci)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "meetup-ios.xcodeproj",
      team_id: "KLT4S6K9X8",
      bundle_identifier: "gautamlgtm.meetup-ios",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore gautamlgtm.meetup-ios"
    )
    build_app(
      project: "meetup-ios.xcodeproj",
      scheme: "meetup-ios",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "gautamlgtm.meetup-ios" => "match AppStore gautamlgtm.meetup-ios"
        }
      }
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 1800
    )
  end
end
