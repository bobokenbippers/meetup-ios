// Template for Secrets.xcconfig (which is gitignored).
//
// Local setup: copy this file to `Secrets.xcconfig` and fill in real values.
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// CI generates Secrets.xcconfig from GitHub Actions secrets, so the real
// keys never live in the repo. Leaving a value blank is fine — the app
// degrades gracefully ("Happening near you" just stays empty).

// Ticketmaster Discovery API consumer key (https://developer.ticketmaster.com).
TICKETMASTER_API_KEY =

// Google Maps Platform API key with Routes API enabled.
GOOGLE_MAPS_API_KEY =

// App-level runtime config used by services that share one app env payload.
// Recommended local form:
// APP_ENV = OPENROUTESERVICE_API_KEY=your-key-here
// JSON also works when injected by CI: {"OPENROUTESERVICE_API_KEY":"..."}
// GitHub Actions builds derive this from the OPENROUTE_APP_KEY repository secret.
APP_ENV =
