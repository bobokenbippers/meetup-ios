// Template for Secrets.xcconfig (which is gitignored).
//
// Local setup: copy this file to `Secrets.xcconfig` and fill in real values.
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// CI generates Secrets.xcconfig from GitHub Actions secrets, so the real
// keys never live in the repo. Leaving a value blank is fine — the app
// degrades gracefully (Places search / "Happening near you" just stay empty).

// Google Cloud key for the Places SDK. Restrict it to the iOS bundle id
// `gautamlgtm.meetup-ios` + Places API in Google Cloud Console.
GOOGLE_PLACES_API_KEY =

// Ticketmaster Discovery API consumer key (https://developer-acct.ticketmaster.com).
TICKETMASTER_API_KEY =
