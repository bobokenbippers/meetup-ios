<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Squad Brunch uses your location to suggest nearby events and share your ETA during active meetups.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Squad Brunch uses background location only during active meetups so friends can see your live ETA.</string>
	<key>NSMotionUsageDescription</key>
	<string>Used to adapt location updates to save battery during active meetups.</string>
	<key>NSContactsUsageDescription</key>
	<string>Squad Brunch uses contacts only when you choose to find friends or fill in your profile details.</string>
	<key>NSCameraUsageDescription</key>
	<string>Squad Brunch uses the camera when you choose to scan receipts or add in-app photo proof.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Squad Brunch uses selected photos when you choose images for chats, meetups, receipts, or your profile.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>TicketmasterAPIKey</key>
	<string>$(TICKETMASTER_API_KEY)</string>
	<key>AppEnvironment</key>
	<string>$(APP_ENV)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>gautamlgtm.meetup-ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>squadbrunch</string>
			</array>
		</dict>
	</array>
	<!-- API keys and app environment are injected at build time from
	     Secrets.xcconfig (gitignored) via build setting substitution, so real
	     secrets never live in the repo. See Secrets.example.xcconfig. -->
</dict>
</plist>
